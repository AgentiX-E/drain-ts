{
  "name": "@agentix-e/drain-ts",
  "version": "1.1.1",
  "description": "A production-ready TypeScript/Node.js streaming log template miner — 1:1 port of the official Python Drain3 algorithm. Extracts structured templates from unstructured logs in real time using fixed-depth prefix tree clustering with zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./presets": {
      "types": "./dist/presets.d.ts",
      "import": "./dist/presets.js",
      "require": "./dist/presets.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "pnpm build:browser && playwright test --config=playwright.config.ts",
    "build:browser": "tsup src/browser-test.ts --format iife --out-dir dist-browser --target es2022 --platform browser --global-name DrainTs --clean",
    "test:coverage": "vitest run --coverage",
    "test:benchmark": "vitest run --config vitest.benchmark.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ 2>/dev/null || echo '[lint] ESLint not configured'",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'benchmark/**/*.ts' 'docs/**/*.md'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'benchmark/**/*.ts' 'docs/**/*.md'",
    "ci": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:coverage",
    "ci:local": "pnpm build && pnpm typecheck && pnpm test:coverage",
    "docs:generate": "typedoc --out docs/api src/index.ts",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "drain",
    "drain3",
    "log-parsing",
    "log-template",
    "log-miner",
    "template-mining",
    "log-analysis",
    "observability",
    "typescript",
    "streaming",
    "online-learning",
    "log-clustering",
    "structured-logging",
    "nodejs",
    "zero-dependency"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AgentiX-E/drain-ts.git"
  },
  "license": "MIT",
  "author": "Lambertyan <lambertyan@agentix-e.dev>",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "peerDependenciesMeta": {},
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "playwright": "^1.62.0",
    "prettier": "^3.9.6",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "esbuild": "0.28.1"
    }
  }
}
